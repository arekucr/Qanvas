# Qanvas configuration. setup copies this file to .env on the first install; edit .env, not this file.

# GPU (index from `nvidia-smi`) that generates images with ComfyUI. Needs 12 GB of VRAM or more.
COMFY_GPU=0

# GPU for the prompt enhancer. Same as COMFY_GPU = they share the card and take turns (default, 1 GPU).
# With a second GPU of 8 GB or more, put its index (e.g. 1): both work at the same time and it's faster.
LLM_GPU=0

# Port of the web app: http://localhost:3000
APP_PORT=3000

# Hours generated images and uploaded photos are kept before they are deleted automatically.
RETENTION_HOURS=24

# Extra ComfyUI arguments. With 64 GB of RAM or more you can remove --disable-pinned-memory for faster loads.
COMFY_ARGS=--disable-pinned-memory
